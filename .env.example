# Core auth (optional; set this if you want x-api-key enforcement)
API_KEY=replace-with-a-random-secret

# Dashboard is open (read-only telemetry, no key required): http://localhost:8000/dashboard

# LLM (OpenRouter free models). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the free-model fallback chain (comma separated, tried in order).
# Leave blank to use the built-in chain from openrouter_free_models.txt.
OPENROUTER_MODELS=

# Agent behavior
AGENT_MAX_HISTORY_MESSAGES=12
LLM_TIMEOUT_SECONDS=12
REQUEST_TIMEOUT_BUDGET_SECONDS=26
ENABLE_LLM_BEHAVIOR_ANALYSIS=true
HIGH_LOAD_MODE=false
LLM_GLOBAL_RPM_LIMIT=26
LLM_REPLY_RPM_LIMIT=18
LLM_BEHAVIOR_RPM_LIMIT=8
LLM_EXTRACTION_RPM_LIMIT=6
LLM_BEHAVIOR_SAMPLE_EVERY_N_SCAM_MESSAGES=2
FAST_SESSION_CLOSE=true

# Structured extraction (LLM) (optional)
ENABLE_LLM_EXTRACTION=true
LLM_EXTRACTION_MIN_INTERVAL_SECONDS=15
INACTIVITY_FINALIZE_SECONDS=120

# Session store (in-memory) cleanup
SESSION_TTL_SECONDS=21600
SESSION_CLEANUP_INTERVAL_SECONDS=60


# Include the full session report in /api/message responses
HONEY_POT_EXTENDED_RESPONSE=false

# Server port
PORT=8000
